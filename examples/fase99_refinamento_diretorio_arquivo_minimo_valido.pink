pacote main;

trazer ambiente.argumento_ou;
trazer caminho.criar_diretorio, diretorio_atual, e_diretorio, existe, juntar, remover_arquivo;

carinho principal() -> bombom {
    nova base: verso = diretorio_atual();
    nova nome_dir: verso = argumento_ou(0, "fase99_saida");
    nova dir: verso = juntar(base, nome_dir);
    criar_diretorio(dir);

    nova arquivo: verso = argumento_ou(1, juntar(base, "__fase99_arquivo_para_remover__.txt"));

    remover_arquivo(arquivo);

    falar(existe(dir));
    falar(e_diretorio(dir));
    falar(existe(arquivo));

    talvez e_diretorio(dir) {
        talvez existe(arquivo) {
            remover_arquivo(arquivo);
            mimo 0;
        } senao {
            mimo 1;
        }
    } senao {
        mimo 0;
    }
}

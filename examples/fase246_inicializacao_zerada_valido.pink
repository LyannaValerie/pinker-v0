pacote main;

trazer memoria.alocar, liberar;

carinho principal() -> bombom {
    nova bytes: seta<u8> = alocar(17);
    nova meio: seta<u64> = (bytes virar seta<bombom> + 8) virar seta<u64>;
    nova ultimo: seta<u8> = (bytes virar seta<bombom> + 16) virar seta<u8>;
    falar(*bytes);
    falar(*meio);
    falar(*ultimo);
    liberar(bytes);
    mimo 0;
}

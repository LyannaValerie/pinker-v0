pacote main;

trazer lista.criar;

// D1 negativo — extração com quantidade errada de bindings.
leque Evento {
    Dados(bombom, lista<bombom>, verso),
    Encerrar,
}

carinho principal() -> bombom {
    nova valores: lista<bombom> = criar();
    nova ev: Evento = Evento.Dados(1, valores, "ok");
    encaixe ev {
        caso Evento.Dados(n, l) { falar(n); }
        caso Evento.Encerrar { falar(0); }
    }
    mimo 0;
}

pacote main;

trazer ambiente.argumento_ou;
trazer arquivo.criar, escrever_verso, fechar, ler_verso;
trazer caminho.diretorio_atual, e_arquivo, existe, juntar;
trazer texto.tamanho;

carinho principal() -> bombom {
    nova base: verso = argumento_ou(0, diretorio_atual());
    nova nome: verso = argumento_ou(1, "fase101_saida.txt");
    nova texto: verso = argumento_ou(2, "ola fase101");

    nova alvo: verso = juntar(base, nome);
    nova h: bombom = criar(alvo);
    escrever_verso(h, texto);
    nova relido: verso = ler_verso(h);
    fechar(h);

    falar(relido);

    talvez existe(alvo) {
        talvez e_arquivo(alvo) {
            talvez tamanho(relido) > 0 {
                mimo 1;
            } senao {
                mimo 0;
            }
        } senao {
            mimo 0;
        }
    } senao {
        mimo 0;
    }
}

pacote fase158_csv_minimo_valido;

trazer csv.emitir_linha_bombom, ler_linha_bombom;
trazer lista.bombom_obter, bombom_tamanho;

carinho principal() -> bombom {
    nova itens: lista<bombom> = ler_linha_bombom("7,11,13", ",");
    nova linha: verso = emitir_linha_bombom(itens, ",");

    falar(bombom_tamanho(itens));
    falar(bombom_obter(itens, 1));
    falar(linha);
    mimo 0;
}

(1, "evidencia.interpreter.execucao-chamadas-e-curto-circuito", "region", Some("interpreter"), Some("evidencia"), "tests/interpreter_tests.rs", "Verifica chamadas de função (simples, com argumentos na ordem, encadeada, void como statement) e curto-circuito de e/ou que não avalia o lado direito, por igualdade de valor de runtime.", "fnv1a64:06bec7f8ca152f49", "active")

pacote main;

trazer ambiente.buscar_contexto;
trazer ambiente.quantos_argumentos;
trazer ambiente.tem_flag;
trazer texto.igual;

carinho principal() -> bombom {
    nova saida: verso = buscar_contexto("--saida", "PINKER_FASE143_SAIDA", "padrao.txt");
    nova usou_padrao: logica = igual(saida, "padrao.txt");
    nova quiet: logica = tem_flag("--quiet");
    nova total: bombom = quantos_argumentos();
    falar(saida);
    falar(usou_padrao);
    falar(total);
    talvez quiet {
        mimo 1;
    } senao {
        mimo 0;
    }
}

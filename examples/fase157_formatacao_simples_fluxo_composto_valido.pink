pacote fase157_formatacao_simples_fluxo_composto_valido;

trazer lista.bombom_anexar, bombom_criar, bombom_obter, bombom_tamanho;
trazer texto.formatar;

carinho montar_item(chave: verso, valor: bombom) -> verso {
    mimo formatar("{}={}", chave, valor);
}

carinho principal() -> bombom {
    nova itens: lista<bombom> = bombom_criar();
    bombom_anexar(itens, 7);
    bombom_anexar(itens, 9);

    falar(formatar("relatorio {}", "rodada"));
    falar(montar_item("total", bombom_tamanho(itens)));
    falar(montar_item("primeiro", bombom_obter(itens, 0)));
    mimo 0;
}

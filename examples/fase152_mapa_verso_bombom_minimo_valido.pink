pacote main;

trazer mapa.verso_bombom_criar, verso_bombom_definir, verso_bombom_obter, verso_bombom_tem;

carinho principal() -> bombom {
    nova m: mapa<verso,bombom> = verso_bombom_criar();
    verso_bombom_definir(m, "pontos", 42);

    talvez verso_bombom_tem(m, "pontos") {
        nova v: bombom = verso_bombom_obter(m, "pontos");
        falar(v);
        mimo v;
    }

    mimo 0;
}

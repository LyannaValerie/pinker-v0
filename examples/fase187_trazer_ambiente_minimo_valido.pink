pacote main;

trazer ambiente.buscar_contexto;
trazer ambiente.quantos_argumentos;
trazer ambiente.tem_flag;
trazer ambiente.variavel_ou;

carinho principal() -> bombom {
    nova saida: verso = buscar_contexto("--saida", "PINKER_FASE187_AMBIENTE", "padrao.txt");
    nova origem: verso = variavel_ou("PINKER_FASE187_AMBIENTE", "sem-env");
    nova quiet: logica = tem_flag("--quiet");
    nova total: bombom = quantos_argumentos();
    falar(saida);
    falar(origem);
    talvez quiet {
        falar("quiet");
    } senao {
        falar("normal");
    }
    mimo total;
}

pacote main;

trazer assertiva.afirmar;
trazer texto.contem, igual, vazio;

eterno SAUDACAO: verso = "olá mundo";
eterno VAZIO: verso = "";

carinho principal() -> bombom {
    afirmar(igual(SAUDACAO, "olá mundo"), "constante verso falhou");
    afirmar(vazio(VAZIO), "constante vazia falhou");
    afirmar(contem(SAUDACAO, "mundo"), "contem falhou");

    falar(SAUDACAO);
    mimo 0;
}

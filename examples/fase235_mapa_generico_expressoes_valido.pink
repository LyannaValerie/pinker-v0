pacote demo;

trazer mapa.definir;
trazer mapa.obter;
trazer mapa.remover;
trazer mapa.tamanho;
trazer mapa.tem;
trazer texto.igual;

carinho mapa_idades() -> mapa<verso,bombom> {
    nova m: mapa<verso,bombom> = mapa_criar();
    definir(m, "idade", 42);
    mimo m;
}

carinho mapa_nomes() -> mapa<verso,verso> {
    nova m: mapa<verso,verso> = mapa_criar();
    definir(m, "nome", "pinker");
    mimo m;
}

carinho mapa_pontos() -> mapa<bombom,bombom> {
    nova m: mapa<bombom,bombom> = mapa_criar();
    definir(m, 7, 35);
    mimo m;
}

carinho mapa_rotulos() -> mapa<bombom,verso> {
    nova m: mapa<bombom,verso> = mapa_criar();
    definir(m, 1, "ok");
    mimo m;
}

carinho mapa_vazio() -> mapa<verso,bombom> {
    nova m: mapa<verso,bombom> = mapa_criar();
    mimo m;
}

carinho principal() -> bombom {
    nova idade: bombom = obter(mapa_idades(), "idade");
    nova tem_nome: logica = tem(mapa_nomes(), "nome");
    nova soma: bombom = obter(mapa_pontos(), 7) + tamanho(mapa_idades());
    nova rotulo: verso = obter(mapa_rotulos(), 1);

    definir(mapa_vazio(), "descartado", 1);
    remover(mapa_rotulos(), 1);

    talvez idade == 42 && tem_nome && soma == 36 && igual(rotulo, "ok") {
        mimo 0;
    } senao {
        mimo 1;
    }
}

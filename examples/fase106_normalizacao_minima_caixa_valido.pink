pacote main;

trazer ambiente.argumento_ou;
trazer texto.contem, igual, maiusculo, minusculo;

carinho principal() -> bombom {
    nova entrada: verso = argumento_ou(0, "PiNkEr V0");
    nova baixo: verso = minusculo(entrada);
    nova alto: verso = maiusculo(entrada);

    nova ok_baixo: logica = igual(baixo, "pinker v0");
    nova ok_alto: logica = contem(alto, "PINKER");

    falar(ok_baixo, ok_alto);

    talvez ok_baixo {
        talvez ok_alto {
            mimo 1;
        } senao {
            mimo 0;
        }
    } senao {
        mimo 0;
    }
}

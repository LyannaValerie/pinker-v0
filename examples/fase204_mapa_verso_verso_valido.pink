pacote main;

trazer mapa.verso_verso_criar;
trazer mapa.verso_verso_definir;
trazer mapa.verso_verso_obter;
trazer mapa.verso_verso_remover;
trazer mapa.verso_verso_tamanho;

carinho principal() -> bombom {
    nova cores: mapa<verso,verso> = verso_verso_criar();
    verso_verso_definir(cores, "sol", "amarelo");
    verso_verso_definir(cores, "ceu", "azul");
    verso_verso_definir(cores, "grama", "verde");

    falar(verso_verso_obter(cores, "sol"));
    falar(verso_verso_obter(cores, "ceu"));
    falar(verso_verso_obter(cores, "grama"));

    falar(verso_verso_tamanho(cores));

    verso_verso_remover(cores, "grama");
    falar(verso_verso_tamanho(cores));

    para cada chave em cores {
        falar(chave);
    }

    mimo 0;
}

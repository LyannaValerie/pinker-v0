pacote main;

trazer mapa.bombom_verso_criar;
trazer mapa.bombom_verso_definir;
trazer mapa.bombom_verso_obter;
trazer mapa.bombom_verso_remover;
trazer mapa.bombom_verso_tamanho;

carinho principal() -> bombom {
    nova nomes: mapa<bombom,verso> = bombom_verso_criar();
    bombom_verso_definir(nomes, 1, "Ana");
    bombom_verso_definir(nomes, 2, "Bruno");
    bombom_verso_definir(nomes, 3, "Carla");

    falar(bombom_verso_obter(nomes, 1));
    falar(bombom_verso_obter(nomes, 2));
    falar(bombom_verso_obter(nomes, 3));

    falar(bombom_verso_tamanho(nomes));

    bombom_verso_remover(nomes, 3);
    falar(bombom_verso_tamanho(nomes));

    para cada chave em nomes {
        falar(chave);
    }

    mimo 0;
}

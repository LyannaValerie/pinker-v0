pacote main;

trazer ambiente.argumento_ou;
trazer arquivo.abrir, fechar, ler_verso;
trazer caminho.criar_diretorio, diretorio_atual, e_diretorio, existe, juntar, remover_diretorio;
trazer texto.tamanho;

carinho principal() -> bombom {
    nova base: verso = diretorio_atual();
    nova nome_dir: verso = argumento_ou(0, "fase100_saida");
    nova nome_arquivo: verso = argumento_ou(1, "README.md");

    nova alvo_dir: verso = juntar(base, nome_dir);
    nova alvo_arquivo: verso = juntar(base, nome_arquivo);

    nova h: bombom = abrir(alvo_arquivo);
    nova texto: verso = ler_verso(h);
    fechar(h);

    falar(tamanho(texto));

    criar_diretorio(alvo_dir);
    remover_diretorio(alvo_dir);
    falar(existe(alvo_dir), e_diretorio(alvo_dir));

    talvez existe(alvo_dir) {
        mimo 0;
    } senao {
        talvez tamanho(texto) > 0 {
            mimo 1;
        } senao {
            mimo 0;
        }
    }
}

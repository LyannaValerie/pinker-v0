pacote main;

trazer tempo.formatar_unix;
trazer tempo.unix;
trazer texto.igual;

carinho principal() -> bombom {
    nova base: bombom = 0;
    nova texto: verso = formatar_unix(base);
    nova agora: bombom = unix();
    falar(texto);
    falar(agora);
    talvez igual(texto, "1970-01-01T00:00:00Z") && agora > 0 {
        mimo 186;
    }
    mimo 0;
}

pacote main;

trazer texto.igual;
trazer texto.juntar;
trazer texto.tamanho;

carinho sauda(nome: verso) -> verso {
    mimo juntar("ola ", nome);
}

carinho principal() -> bombom {
    nova nome: verso = "rosa";
    nova saudacao: verso = sauda(nome);
    falar(saudacao);

    nova completo: verso = juntar(saudacao, juntar(" ", "pinker"));
    falar(completo, tamanho(completo), verdade);

    talvez igual(saudacao, "ola rosa") {
        falar("igual confere");
    }

    falar(tamanho("coração"));
    mimo tamanho(completo) - 15;
}

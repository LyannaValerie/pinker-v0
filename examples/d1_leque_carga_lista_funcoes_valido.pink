pacote main;

trazer lista.anexar, criar, obter, tamanho;

// D1 — construção e extração fora de `principal`.
//
// A carga de lista atravessa parâmetro, retorno, chamada direta, chamada
// indireta por função local tipada e alias local de função, sem deixar de ser
// o mesmo handle: a cópia é rasa em todos esses pontos.
leque Cor {
    Rosa,
    Azul,
}

leque Pacote {
    Numeros(lista<bombom>),
    Cores(lista<Cor>),
    Vazio,
}

// Construção numa função auxiliar, a partir de um parâmetro.
carinho empacotar(valores: lista<bombom>) -> Pacote {
    mimo Pacote.Numeros(valores);
}

// Extração numa função auxiliar, devolvendo a lista extraída.
carinho desempacotar(p: Pacote) -> lista<bombom> {
    nova muda saida: lista<bombom> = criar();
    encaixe p {
        caso Pacote.Numeros(v) { saida = v; }
        caso Pacote.Cores(c) { }
        caso Pacote.Vazio { }
    }
    mimo saida;
}

carinho tamanho_do_pacote(p: Pacote) -> bombom {
    nova muda total: bombom = 0;
    encaixe p {
        caso Pacote.Numeros(v) { total = tamanho(v); }
        caso Pacote.Cores(c) { total = tamanho(c); }
        caso Pacote.Vazio { total = 0; }
    }
    mimo total;
}

carinho cores_empacotadas(cores: lista<Cor>) -> Pacote {
    mimo Pacote.Cores(cores);
}

carinho principal() -> bombom {
    nova base: lista<bombom> = criar();
    anexar(base, 2);
    anexar(base, 3);

    // Chamada direta: construção e extração em funções auxiliares.
    nova p: Pacote = empacotar(base);
    falar(tamanho_do_pacote(p));

    nova extraida: lista<bombom> = desempacotar(p);
    // O handle devolvido é o mesmo: mutar por ele é visto pelo original.
    anexar(extraida, 4);
    falar(tamanho(base));
    falar(obter(base, 2));

    // Chamada indireta por função local tipada (contrato corrente da
    // linguagem para valores de função).
    nova medir: carinho(Pacote) -> bombom = carinho (q: Pacote) -> bombom {
        nova muda n: bombom = 0;
        encaixe q {
            caso Pacote.Numeros(v) { n = tamanho(v); }
            caso Pacote.Cores(c) { n = tamanho(c); }
            caso Pacote.Vazio { n = 0; }
        }
        mimo n;
    };
    falar(medir(p));

    nova cores: lista<Cor> = criar();
    anexar(cores, Cor.Rosa);
    nova pc: Pacote = cores_empacotadas(cores);
    falar(tamanho_do_pacote(pc));
    encaixe pc {
        caso Pacote.Numeros(v) { falar(tamanho(v)); }
        caso Pacote.Cores(c) {
            para cada cor em c {
                encaixe cor {
                    caso Cor.Rosa { falar("rosa"); }
                    caso Cor.Azul { falar("azul"); }
                }
            }
        }
        caso Pacote.Vazio { falar(0); }
    }

    mimo 0;
}

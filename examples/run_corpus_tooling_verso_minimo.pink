pacote main;

trazer ambiente.argumento;
trazer ambiente.argumento_ou;
trazer ambiente.quantos_argumentos;
trazer ambiente.tem_argumento;
trazer texto.indice;
trazer texto.juntar;
trazer texto.tamanho;

carinho saudacao(nome: verso) -> verso {
    mimo juntar("oi ", nome);
}

carinho principal() -> bombom {
    nova nome: verso = argumento_ou(0, "visitante");
    nova msg: verso = saudacao(nome);

    falar(msg, tamanho(msg), indice(msg, 0));

    talvez tem_argumento(1) {
        falar("extra", argumento(1));
    } senao {
        falar("extra", "nenhum");
    }

    mimo quantos_argumentos();
}

pacote main;

trazer lista.bombom_anexar, bombom_criar, bombom_obter, bombom_tamanho, bombom_tirar_ultimo;

carinho carregar_fila() -> lista<bombom> {
    nova fila: lista<bombom> = bombom_criar();
    bombom_anexar(fila, 4);
    bombom_anexar(fila, 8);
    bombom_anexar(fila, 15);
    mimo fila;
}

carinho fechar_ultimo_lote(fila: lista<bombom>) -> bombom {
    mimo bombom_tirar_ultimo(fila);
}

carinho principal() -> bombom {
    nova fila: lista<bombom> = carregar_fila();
    nova retirado: bombom = fechar_ultimo_lote(fila);
    falar(retirado);
    falar(bombom_tamanho(fila));
    falar(bombom_obter(fila, 1));
    mimo bombom_obter(fila, 0);
}

pacote main;

trazer lista.anexar, criar;

// D1 negativo — o binding extraído conserva o tipo exato da carga.
//
// `lista<verso>` extraída não aceita elemento `bombom`: a extração não pode
// rebaixar a identidade da lista para `lista<bombom>`.
leque Pacote {
    Textos(lista<verso>),
}

carinho principal() -> bombom {
    nova textos: lista<verso> = criar();
    nova p: Pacote = Pacote.Textos(textos);
    encaixe p {
        caso Pacote.Textos(t) { anexar(t, 42); }
    }
    mimo 0;
}

pacote main;

trazer acaso;
trazer arquivo;
trazer acaso.entre, proximo;
trazer arquivo.abrir_anexo, anexar_verso, copiar, escrever_verso, fechar, ler_caminho_ou, ler_caminho_verso;
trazer caminho.e_arquivo, existe, juntar, remover_arquivo, tamanho_arquivo;
trazer tempo.formatar_unix;

carinho principal() -> bombom {
    nova destino: verso = juntar("target", "fase220_teste.txt");
    nova cabo: bombom = arquivo.criar(destino);
    escrever_verso(cabo, "rosa pinker");
    fechar(cabo);
    falar(ler_caminho_verso(destino));
    falar("tamanho:", tamanho_arquivo(destino));
    talvez existe(destino) {
        falar("existe");
    }
    talvez e_arquivo(destino) {
        falar("e arquivo");
    }
    nova anexo: bombom = abrir_anexo(destino);
    anexar_verso(anexo, " canta");
    fechar(anexo);
    falar(ler_caminho_verso(destino));
    falar(ler_caminho_ou("nao_existe_950.txt", "fallback ok"));
    nova copia: verso = juntar("target", "fase220_copia.txt");
    copiar(destino, copia);
    falar("copia:", ler_caminho_verso(copia));
    remover_arquivo(destino);
    remover_arquivo(copia);
    falar("removido:", existe(destino));

    falar(formatar_unix(0));
    falar(formatar_unix(1752249600));

    nova gerador: bombom = acaso.criar(42);
    falar(proximo(gerador));
    falar(entre(gerador, 1, 6));
    falar(entre(gerador, 10, 10));
    mimo 0;
}

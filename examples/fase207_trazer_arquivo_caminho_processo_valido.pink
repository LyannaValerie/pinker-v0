pacote main;

trazer ambiente.argumento;
trazer arquivo.criar, escrever_verso, fechar, ler_caminho_verso;
trazer caminho.existe, juntar, remover_arquivo;
trazer processo.executar;


carinho principal() -> bombom {
    nova destino: verso = juntar("target", "fase207_exemplo.txt");
    nova cabo: bombom = criar(destino);
    escrever_verso(cabo, "rosa pinker");
    fechar(cabo);

    talvez existe(destino) {
        nova conteudo: verso = ler_caminho_verso(destino);
        falar(conteudo);
    }
    remover_arquivo(destino);

    nova comando: verso = argumento(0);
    nova codigo: bombom = executar(comando);
    falar(codigo);
    mimo codigo;
}

pacote main;

trazer acaso.criar, proximo;

carinho principal() -> bombom {
    nova gerador_a: bombom = criar(42);
    nova gerador_b: bombom = criar(42);

    nova a1: bombom = proximo(gerador_a);
    nova b1: bombom = proximo(gerador_b);
    nova a2: bombom = proximo(gerador_a);
    nova b2: bombom = proximo(gerador_b);

    falar(a1, b1);
    falar(a2, b2);
    falar(a1 == b1);
    falar(a2 == b2);
    mimo 0;
}

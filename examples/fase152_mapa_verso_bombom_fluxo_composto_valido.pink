pacote main;

trazer mapa.verso_bombom_criar, verso_bombom_definir, verso_bombom_obter, verso_bombom_tem;

carinho carregar_placar() -> mapa<verso,bombom> {
    nova placar: mapa<verso,bombom> = verso_bombom_criar();
    verso_bombom_definir(placar, "ana", 10);
    verso_bombom_definir(placar, "bia", 20);
    mimo placar;
}

carinho atualizar_ana(placar: mapa<verso,bombom>) {
    talvez verso_bombom_tem(placar, "ana") {
        nova atual: bombom = verso_bombom_obter(placar, "ana");
        verso_bombom_definir(placar, "ana", atual + 5);
    }
}

carinho principal() -> bombom {
    nova placar: mapa<verso,bombom> = carregar_placar();
    atualizar_ana(placar);
    falar(verso_bombom_obter(placar, "ana"));
    falar(verso_bombom_obter(placar, "bia"));
    mimo verso_bombom_obter(placar, "ana");
}

(1, "evidencia.interpreter.diagnostico-render-fonte-e-operador-bitnot", "region", Some("interpreter"), Some("evidencia"), "tests/interpreter_tests.rs", "Cobre renderização de erro com contexto de fonte (parse, semântico, runtime sem span real) e o operador bitnot (til/nope, equivalência, inversão de bits conhecidos, dupla inversão, rejeição por tipo), misturando contains e igualdade.", "fnv1a64:247bc8c511414f5f", "active")

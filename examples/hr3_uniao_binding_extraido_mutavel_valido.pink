pacote main;

// HR3: o storage do binding extraído pertence ao braço, não ao descritor.
// A segunda extração acontece **dentro** do braço da primeira, depois de o
// primeiro binding já ter sido modificado: o segundo binding recebe o snapshot
// original e o primeiro continua com a mutação. Os dois storages coexistem.
ninho Par {
    cabeca: bombom;
    cauda: bombom;
}

carinho principal() -> bombom {
    nova base: seta<Par> = alocar(16) virar seta<Par>;
    (*base).cabeca = 11;
    (*base).cauda = 12;

    nova valor: uniao<Par, u8> = (*base) virar uniao<Par, u8>;

    encaixe valor {
        caso Par(primeiro) {
            primeiro.cabeca = 77;
            primeiro.cauda = 78;

            encaixe valor {
                caso Par(segundo) {
                    falar(segundo.cabeca);
                    falar(segundo.cauda);
                }
                caso u8(numero) {
                    falar(999);
                }
            }

            falar(primeiro.cabeca);
            falar(primeiro.cauda);
        }
        caso u8(numero) {
            falar(999);
        }
    }

    falar((*base).cabeca);
    mimo 0;
}

pacote main;

trazer ambiente.argumento_ou;
trazer arquivo.abrir_anexo;
trazer arquivo.anexar_verso;
trazer arquivo.criar;
trazer arquivo.escrever_verso;
trazer arquivo.fechar;
trazer arquivo.ler_verso;
trazer caminho.juntar;
trazer caminho.tamanho_arquivo;
trazer texto.igual;

carinho principal() -> bombom {
    nova base: verso = argumento_ou(0, "/tmp");
    nova nome: verso = argumento_ou(1, "fase108_append_textual_minimo.txt");
    nova alvo: verso = juntar(base, nome);

    nova h0: bombom = criar(alvo);
    escrever_verso(h0, "base");
    fechar(h0);

    nova h: bombom = abrir_anexo(alvo);
    anexar_verso(h, "+A");
    anexar_verso(h, "+B");
    nova texto: verso = ler_verso(h);
    fechar(h);

    nova tam: bombom = tamanho_arquivo(alvo);
    falar(texto, tam);

    talvez igual(texto, "base+A+B") {
        talvez tam == 8 {
            mimo 1;
        } senao {
            mimo 0;
        }
    } senao {
        mimo 0;
    }
}

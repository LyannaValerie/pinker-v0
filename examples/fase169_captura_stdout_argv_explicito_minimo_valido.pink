pacote main;

trazer ambiente.argumento;
trazer processo.capturar_stdout;
trazer texto.contem;
trazer texto.tamanho;

carinho principal() -> bombom {
    nova comando: verso = argumento(0);
    nova texto: verso = capturar_stdout(comando, "--alvo=rosa");
    nova tem_status: logica = contem(texto, "status=ok");
    nova tem_alvo: logica = contem(texto, "alvo=rosa");
    falar(texto);
    talvez tem_status && tem_alvo && tamanho(texto) == 20 {
        mimo 0;
    }
    mimo 1;
}

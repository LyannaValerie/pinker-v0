// L-03 — não existe fluxo contínuo entre processos.
//
// ATENÇÃO: este repro NÃO TERMINA. É esse o ponto. Rode com limite:
//     timeout 5 pink --run apps/concha/limites/l03_sem_fluxo_continuo.pink
//
// `executar_processo_estruturado` só devolve depois que o filho terminou e foi
// reapado (src/saida_processo.rs:37), então a saída de um produtor infinito é
// acumulada para sempre e nenhum consumidor chega a começar. No bash,
// `yes | head -1` imprime uma linha e acaba, porque `head` sai e `yes` toma
// SIGPIPE.
//
// A alternativa segura é `LimiteTempo.Ate(ms)`: troque a última linha por
// `LimiteTempo.Ate(2000)` e o repro vira "limite de tempo excedido" — que é
// deadline, não fluxo.
pacote main;

apelido Res = Resultado<SaidaProcesso, verso>;

carinho principal() -> bombom {
    nova muda argv: lista<verso> = lista_verso_criar();
    lista_verso_anexar(argv, "-c");
    lista_verso_anexar(argv, "yes");
    nova muda amb: mapa<verso,verso> = mapa_verso_verso_criar();
    falar("comecando o produtor infinito...");
    nova r: Res = executar_processo_estruturado("sh", argv, "", "", amb, LimiteTempo.SemLimite);
    encaixe r {
        caso Res.Ok(s) { falar("nunca chega aqui:", tamanho_verso(processo_saida(s))); }
        caso Res.Erro(e) { falar("ERRO:", e); }
    }
    mimo 0;
}

pacote main;

trazer acaso.criar;
trazer acaso.entre;
trazer assertiva.afirmar;
trazer lista.bombom_anexar;
trazer lista.bombom_criar;
trazer lista.bombom_inserir;
trazer lista.bombom_obter;
trazer mapa.verso_bombom_criar;
trazer mapa.verso_bombom_definir;
trazer mapa.verso_bombom_remover;
trazer mapa.verso_bombom_tem;
trazer texto.bombom_para_verso;
trazer texto.igual;
trazer texto.verso_para_bombom;

carinho principal() -> bombom {
    // verso_para_bombom e bombom_para_verso
    nova texto: verso = "42";
    nova numero: bombom = verso_para_bombom(texto);
    nova de_volta: verso = bombom_para_verso(numero);
    afirmar(numero == 42, "conversão verso->bombom falhou");
    afirmar(igual(de_volta, "42"), "conversão bombom->verso falhou");

    // aleatorio_entre
    nova gen: bombom = criar(12345);
    nova valor: bombom = entre(gen, 1, 100);
    afirmar(valor >= 1, "aleatorio_entre abaixo do min");
    afirmar(valor <= 100, "aleatorio_entre acima do max");

    // lista_bombom_inserir
    nova lista: lista<bombom> = bombom_criar();
    bombom_anexar(lista, 10);
    bombom_anexar(lista, 30);
    bombom_inserir(lista, 1, 20);
    afirmar(bombom_obter(lista, 0) == 10, "lista[0] deveria ser 10");
    afirmar(bombom_obter(lista, 1) == 20, "lista[1] deveria ser 20");
    afirmar(bombom_obter(lista, 2) == 30, "lista[2] deveria ser 30");

    // mapa_verso_bombom_remover
    nova mapa: mapa<verso,bombom> = verso_bombom_criar();
    verso_bombom_definir(mapa, "a", 1);
    verso_bombom_definir(mapa, "b", 2);
    verso_bombom_remover(mapa, "a");
    afirmar(!verso_bombom_tem(mapa, "a"), "chave 'a' deveria ter sido removida");
    afirmar(verso_bombom_tem(mapa, "b"), "chave 'b' deveria existir");

    falar("todas as afirmações passaram");
    mimo 0;
}

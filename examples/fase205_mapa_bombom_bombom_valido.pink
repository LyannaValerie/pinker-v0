pacote main;

trazer mapa.bombom_bombom_criar;
trazer mapa.bombom_bombom_definir;
trazer mapa.bombom_bombom_obter;
trazer mapa.bombom_bombom_remover;
trazer mapa.bombom_bombom_tamanho;

carinho principal() -> bombom {
    nova contagem: mapa<bombom,bombom> = bombom_bombom_criar();
    bombom_bombom_definir(contagem, 1, 100);
    bombom_bombom_definir(contagem, 2, 200);
    bombom_bombom_definir(contagem, 3, 300);

    falar(bombom_bombom_obter(contagem, 1));
    falar(bombom_bombom_obter(contagem, 2));
    falar(bombom_bombom_obter(contagem, 3));

    falar(bombom_bombom_tamanho(contagem));

    bombom_bombom_remover(contagem, 3);
    falar(bombom_bombom_tamanho(contagem));

    para cada chave em contagem {
        falar(chave);
    }

    mimo 0;
}

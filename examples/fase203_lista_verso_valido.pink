pacote main;

trazer lista.verso_anexar, verso_criar, verso_definir, verso_inserir, verso_obter, verso_tamanho, verso_tirar_ultimo;

carinho principal() -> bombom {
    nova nomes: lista<verso> = verso_criar();
    verso_anexar(nomes, "Ana");
    verso_anexar(nomes, "Bruno");
    verso_anexar(nomes, "Carla");

    falar(verso_tamanho(nomes));

    falar(verso_obter(nomes, 0));
    falar(verso_obter(nomes, 1));
    falar(verso_obter(nomes, 2));

    verso_definir(nomes, 1, "Beatriz");
    falar(verso_obter(nomes, 1));

    nova ultimo: verso = verso_tirar_ultimo(nomes);
    falar(ultimo);
    falar(verso_tamanho(nomes));

    verso_inserir(nomes, 0, "Zara");
    falar(verso_obter(nomes, 0));
    falar(verso_tamanho(nomes));

    mimo 0;
}

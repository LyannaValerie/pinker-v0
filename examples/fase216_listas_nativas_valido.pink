pacote main;

trazer lista.anexar, criar, definir, inserir, tamanho, tirar_ultimo;

leque Cor { Vermelho, Verde, Azul }

carinho soma_lista(numeros: lista<bombom>) -> bombom {
    nova muda total: bombom = 0;
    para cada n em numeros {
        total = total + n;
    }
    mimo total;
}

carinho principal() -> bombom {
    nova numeros: lista<bombom> = criar();
    anexar(numeros, 5);
    anexar(numeros, 10);
    anexar(numeros, 30);
    definir(numeros, 0, 2);
    inserir(numeros, 1, 100);
    nova tirado: bombom = tirar_ultimo(numeros);
    falar("tirado:", tirado);
    falar("tamanho:", tamanho(numeros));
    falar("soma:", soma_lista(numeros));

    nova palavras: lista<verso> = criar();
    anexar(palavras, "rosa");
    anexar(palavras, "pinker");
    para cada p em palavras {
        falar(p);
    }

    nova cores: lista<Cor> = criar();
    anexar(cores, Cor.Verde);
    anexar(cores, Cor.Azul);
    para cada c em cores {
        escolha c {
            caso Cor.Verde { falar("fria verde"); }
            caso Cor.Azul { falar("fria azul"); }
            senao { falar("quente"); }
        }
    }
    mimo soma_lista(numeros) - 112;
}

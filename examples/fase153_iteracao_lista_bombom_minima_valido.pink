pacote main;

trazer lista.bombom_anexar, bombom_criar;

carinho principal() -> bombom {
    nova itens: lista<bombom> = bombom_criar();
    bombom_anexar(itens, 5);
    bombom_anexar(itens, 7);

    nova muda soma: bombom = 0;
    para cada item em itens {
        soma = soma + item;
    }

    falar(soma);
    mimo soma;
}

#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Uso:
  scripts/pink-baseline build --output DIRETÓRIO
  scripts/pink-baseline manifest --bundle DIRETÓRIO [--release-root DIRETÓRIO]
  scripts/pink-baseline ficha --bundle DIRETÓRIO [--release-root DIRETÓRIO]
                              [--perfil NOME] [--data AAAA-MM-DD]
  sudo scripts/pink-baseline publish --bundle DIRETÓRIO

build cria um bundle release identificado como usuário comum.
manifest e ficha apenas renderizam registros derivados do bundle, sem root e
sem escrever fora da saída padrão.
publish valida o bundle e troca /opt/pinker/bin/pink atomicamente como root.
EOF
}

fail() {
    printf 'pink-baseline: %s\n' "$*" >&2
    exit 1
}

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"

# Raiz da instalação administrada. /opt é o único valor de produção e o default
# exato: sem a variável, todo caminho abaixo é literalmente o de antes.
#
# A variável existe por um motivo só — a atomicidade da publicação não pode ser
# provada mutando /opt vivo —, e por isso ela recusa /opt e qualquer caminho
# dentro dele: a seam nunca alcança a instalação real. Não é interface da Pinker,
# não aparece em `usage` e não é um sistema geral de prefixos; é isolamento de
# teste. Em raiz isolada não há root nem posse root:root a exigir, então o gate
# de root e os flags de posse acompanham a raiz.
forja_root="${PINK_BASELINE_ROOT:-/opt}"
if [[ "$forja_root" != '/opt' ]]; then
    [[ "$forja_root" == /* ]] || fail "PINK_BASELINE_ROOT deve ser absoluto"
    [[ "$forja_root" != '/' ]] || fail "PINK_BASELINE_ROOT não pode ser a raiz do sistema"
    [[ "$forja_root" != /opt/* ]] || fail "PINK_BASELINE_ROOT não pode viver dentro de /opt"
    [[ -d "$forja_root" ]] || fail "PINK_BASELINE_ROOT inexistente: $forja_root"
fi

exposed_command="$forja_root/pinker/bin/pink"

# Lê identity.env do bundle para as variáveis de identidade. Um bundle é a única
# origem aceita: nada aqui recalcula versão, commit ou checksum por conta própria.
read_bundle_identity() {
    local bundle="$1"
    [[ -d "$bundle" && -x "$bundle/pink" && -f "$bundle/identity.env" ]] || fail "bundle incompleto"
    schema=''
    version=''
    commit=''
    expected_sha256=''
    source=''
    while IFS='=' read -r key value; do
        case "$key" in
            schema) schema="$value" ;;
            version) version="$value" ;;
            commit) commit="$value" ;;
            sha256) expected_sha256="$value" ;;
            source) source="$value" ;;
            *) fail "campo desconhecido no bundle: $key" ;;
        esac
    done <"$bundle/identity.env"
    [[ "$schema" == 'forja-pink-bundle-v1' ]] || fail "schema do bundle inválido"
    [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "versão inválida"
    [[ "$commit" =~ ^[0-9a-f]{40}$ ]] || fail "commit inválido"
    [[ "$expected_sha256" =~ ^[0-9a-f]{64}$ ]] || fail "SHA-256 esperado inválido"
    [[ "$source" =~ ^/[A-Za-z0-9_./-]+$ ]] || fail "origem do bundle inválida"
}

# O manifest é serializado pela mesma construção que a autoridade validadora usa
# para decidir se a forma é canônica (json.dumps ordenado, indent=2). Formatar
# JSON à mão dentro de heredoc já produziu manifest inválido; a corretude aqui é
# por construção, não por acerto de aspas.
render_manifest() {
    local release_root="$1" exposed="$2"
    command -v python3 >/dev/null 2>&1 || fail "python3 ausente: renderização canônica indisponível"
    PINK_VERSION="$version" \
        PINK_COMMIT="$commit" \
        PINK_SHA256="$expected_sha256" \
        PINK_SOURCE="$source" \
        PINK_RELEASE_ROOT="$release_root" \
        PINK_EXPOSED="$exposed" \
        PINK_BUNDLE_SCHEMA="$schema" \
        python3 - <<'PYTHON'
import json
import os

release_root = os.environ["PINK_RELEASE_ROOT"]
exposed = os.environ["PINK_EXPOSED"]
commit = os.environ["PINK_COMMIT"]
sha256 = os.environ["PINK_SHA256"]
release_binary = f"{release_root}/bin/pink"

# O comando exposto é um symlink para o binário da release: o validador segue o
# link ao somar o checksum, então ambos os caminhos declaram o mesmo digest.
declared = sorted({release_binary, exposed})

print(
    json.dumps(
        {
            "checksums": [{"path": path, "sha256": sha256} for path in declared],
            "exposed_commands": [exposed],
            "installation_root": release_root,
            "installed_executables": [release_binary],
            "name": "Pinker CLI",
            "ownership_policy": {
                "group": "root",
                "owner": "root",
                "writable_by_non_admin": False,
            },
            "schema": "forja-software-manifest-v1",
            "source_or_provenance": {
                "kind": "repository-release-build",
                "source": os.environ["PINK_SOURCE"],
                "commit": commit,
                "bundle_schema": os.environ["PINK_BUNDLE_SCHEMA"],
            },
            "verification": {
                "command": [exposed, "--version-json"],
                "expected_contains": f'"binary_commit":"{commit}"',
            },
            "version": os.environ["PINK_VERSION"],
            "wrappers": [],
        },
        ensure_ascii=False,
        indent=2,
        sort_keys=True,
    )
)
PYTHON
}

# Ficha de catálogo da Forja derivada do mesmo bundle. Não escreve em
# /pinker/msg: o regime de escrita daquele espaço é por perfil e pertence ao
# agente, não ao publicador administrativo.
render_ficha() {
    local release_root="$1" perfil="$2" data="$3"
    [[ -n "$perfil" ]] || fail "perfil vazio"
    [[ "$data" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || fail "data inválida: $data"
    cat <<EOF
---
tipo: ferramenta
nome: pink
versao: $version
perfil: $perfil
data: $data
pinker: nao
motivo_pinker: é o próprio compilador e CLI da Pinker, escrito em Rust, e precisa existir antes de qualquer build Pinker
invocacao: pink
local: $exposed_command (release em $release_root)
arquivo_principal: $exposed_command
executavel: sim
interface_padrao: sim
estado: instalado
linguagem: Rust
resumo: launcher canônico da Pinker publicado por scripts/pink-baseline, com identidade verificável por --version-json
---

# \`pink\`

Registro derivado de \`scripts/pink-baseline ficha\`, não digitado à mão.
A release publicada é \`$commit\` e o comando exposto é \`$exposed_command\`.

\`interface_padrao\` está declarado porque o próprio launcher responde
\`--help\` e \`--version\`: a saúde derivada desta entrada passa a depender do
launcher real, e não apenas da existência de metadata.
EOF
}

# ---------------------------------------------------------------------------
# Transação de publicação.
#
# A publicação altera três coisas: o diretório da release, o manifest ativo e o
# comando exposto. Só o comando exposto é ativação; os outros dois são preparo.
# O validador canônico decide quase tudo sem ativação nenhuma — forma, campos,
# posse, checksums e a execução real do launcher —, porque um manifest candidato
# pode declarar o binário da release como comando exposto. O que sobra depois da
# ativação é só a amarração final "o link exposto aponta para esta release", e
# essa é uma troca atômica seguida de conferência.
#
# Então: valide o candidato inteiro antes; ative por último; e, se a conferência
# posterior reprovar, restaure o estado anterior exatamente. Restaurar não é pôr
# algo plausível no lugar — o manifest volta byte a byte e o link volta ao alvo
# textual anterior, ou some se antes não existia.
# ---------------------------------------------------------------------------
own=()
publish_scratch=''
publish_release_created=''
publish_manifest_existed=''
publish_manifest_backup=''
publish_link_kind=''
publish_link_target=''
publish_link_backup=''

# Estado da transação. É o menor estado necessário para decidir, em QUALQUER
# saída, se há algo a desfazer:
#
#   PRE_TRANSACTION  nada preparado, nada a desfazer
#   PREPARED         staging e backups existem; nada exposto mudou
#   ACTIVATED        entrou na região de commit; manifest e/ou link podem ter mudado
#   COMMITTED        conferido; desfazer aqui seria destruir uma publicação boa
#   FINALIZED        o funil já decidiu e já agiu; reentrar não pode desfazer de novo
#
# FINALIZED é a guarda de reentrância. Ela não é um flag à parte porque um flag à
# parte seria um segundo mecanismo dizendo a mesma coisa que o estado.
#
# Pela mesma razão não existe mais um `publish_activated`. Ele era um segundo
# mecanismo tentando descrever um subconjunto de ACTIVATED, e como era atribuído
# DEPOIS da troca do launcher, havia um instante em que o launcher novo já estava
# vivo e o rollback ainda lia "launcher intacto": o término restaurava o manifest
# e deixava o launcher novo. Uma flag que só fica verdadeira depois do efeito que
# ela descreve não é autoridade sobre esse efeito.
#
# O estado marca a REGIÃO em que o launcher PODE ter mudado, e é isso que o
# rollback precisa saber. Restaurar dentro da região quando a troca ainda não
# ocorreu reescreve o alvo anterior por cima dele mesmo — idempotente por
# construção, porque o alvo restaurado é o que foi capturado antes da primeira
# mutação.
publish_state=PRE_TRANSACTION
publish_abort_reason=''

publish_cleanup_scratch() {
    [[ -n "$publish_scratch" && -d "$publish_scratch" ]] && rm -rf "$publish_scratch"
    return 0
}

# Quem chama já decidiu, pelo estado, que a transação entrou numa região com o
# que desfazer. Aqui não se pergunta de novo "mas o launcher chegou a mudar?":
# essa pergunta só teria resposta honesta depois do efeito, e é tarde.
publish_restore() {
    case "$publish_link_kind" in
        symlink)
            local back="$forja_root/pinker/bin/.pink-restore-$$"
            rm -f "$back"
            ln -s "$publish_link_target" "$back"
            mv -Tf "$back" "$exposed_command"
            ;;
        file) install "${own[@]}" -m 0755 "$publish_link_backup" "$exposed_command" ;;
        absent) rm -f "$exposed_command" ;;
    esac
    if [[ -n "$publish_manifest_existed" ]]; then
        install "${own[@]}" -m 0644 "$publish_manifest_backup" "$manifest"
    else
        rm -f "$manifest"
    fi
    [[ -n "$publish_release_created" ]] && rm -rf "$release_root"
    return 0
}

# Conferir a restauração faz parte da restauração: um rollback que não é
# observado é uma alegação, não um estado.
publish_restoration_verdict() {
    local verdict='RESTORED_EXACTLY' ok=''
    # A conferência do launcher usa a mesma autoridade que a restauração. Guardá-la
    # atrás de uma condição própria era o que fazia o veredito afirmar
    # RESTORED_EXACTLY justamente na janela em que o launcher não voltara.
    case "$publish_link_kind" in
        symlink)
            if [[ -L "$exposed_command" ]] &&
                [[ "$(readlink "$exposed_command")" == "$publish_link_target" ]]; then
                ok=1
            fi
            ;;
        file)
            if [[ -f "$exposed_command" && ! -L "$exposed_command" ]] &&
                [[ "$(sha256sum <"$exposed_command")" == "$(sha256sum <"$publish_link_backup")" ]]; then
                ok=1
            fi
            ;;
        absent)
            if [[ ! -e "$exposed_command" ]]; then
                ok=1
            fi
            ;;
    esac
    [[ -n "$ok" ]] || verdict='RESTORATION_DIVERGED'
    ok=''
    if [[ -n "$publish_manifest_existed" ]]; then
        if [[ -f "$manifest" ]] &&
            [[ "$(sha256sum <"$manifest")" == "$(sha256sum <"$publish_manifest_backup")" ]]; then
            ok=1
        fi
    elif [[ ! -e "$manifest" ]]; then
        ok=1
    fi
    [[ -n "$ok" ]] || verdict='RESTORATION_DIVERGED'
    printf '%s' "$verdict"
}

# Toda entrada de /opt/pinker/manifests é autoridade viva: o validador canônico
# faz glob de *.json e valida cada uma. Então um manifest Pinker sob outro nome
# não fica "histórico" por ficar para trás — ele continua sendo consultado, e
# passa a falhar assim que o launcher aponta para outra release.
#
# A identidade não vem do nome do arquivo, que o validador nunca interpreta, e
# sim do campo `name` declarado. Selecionar por glob `pink-*.json` seria adivinhar
# a chave; ler o `name` é usá-la. E um manifest que não parseia não pode provar
# que NÃO é nosso, então também conta — fail closed.
publish_superseded_authorities() {
    local mantido="$1" dir="$2"
    command -v python3 >/dev/null 2>&1 || fail "python3 ausente: não é possível ler a coleção"
    PINK_KEEP="$mantido" PINK_DIR="$dir" python3 - <<'PYTHON'
import json
import os
import pathlib

mantido = os.path.realpath(os.environ["PINK_KEEP"])
for caminho in sorted(pathlib.Path(os.environ["PINK_DIR"]).glob("*.json")):
    if os.path.realpath(caminho) == mantido:
        continue
    try:
        nome = json.loads(caminho.read_text(encoding="utf-8")).get("name")
    except (OSError, ValueError):
        print(f"{caminho}\tILEGIVEL")
        continue
    if nome == "Pinker CLI":
        print(f"{caminho}\tPinker CLI")
PYTHON
}

# Funil único de término.
#
# Com `set -e`, uma falha inesperada já vira saída do shell, então EXIT é o funil
# natural e cobre tanto o abort explícito quanto o erro que ninguém roteou.
# Somar um trap ERR ao de EXIT só produziria rollback duplo. INT e TERM não
# desfazem nada por conta própria: eles apenas convertem o sinal em saída, para
# que o mesmo funil decida, e depois devolvem a semântica do sinal.
#
# A limpeza do scratch é a ÚLTIMA coisa: é lá que vivem os backups, e apagá-los
# antes de terminar a restauração é exatamente o defeito que este handler fecha.
publish_finalize() {
    local motivo="$1" verdict='NOT_ATTEMPTED' estado="$publish_state"
    publish_state=FINALIZED

    case "$estado" in
        PREPARED | ACTIVATED)
            # Durante a restauração o `set -e` sai de cena de propósito: um
            # comando que falhe aqui não pode abortar o rollback pela metade nem
            # reentrar no trap. A divergência é medida, não sofrida.
            set +e
            publish_restore
            verdict="$(publish_restoration_verdict)"
            set -e
            ;;
        COMMITTED | PRE_TRANSACTION | FINALIZED) verdict=NOT_NEEDED ;;
    esac

    [[ -n "$publish_abort_reason" ]] &&
        printf 'pink-baseline: publicação abortada: %s\n' "$publish_abort_reason" >&2
    if [[ "$verdict" != 'NOT_NEEDED' ]]; then
        printf 'pink-baseline: término por %s; estado anterior %s\n' "$motivo" "$verdict" >&2
    fi
    publish_cleanup_scratch
    # Restauração divergente é mais grave que o motivo do término: quem chamou
    # precisa saber que o host ficou num estado que ninguém prometeu.
    [[ "$verdict" == 'RESTORATION_DIVERGED' ]] && exit 3
    return 0
}

publish_on_signal() {
    local signo="$1"
    trap - INT TERM EXIT
    publish_finalize "SIG$signo"
    trap - "$signo"
    kill -"$signo" $$
}

publish_arm_traps() {
    trap 'publish_finalize saída' EXIT
    trap 'publish_on_signal INT' INT
    trap 'publish_on_signal TERM' TERM
}

# O abort explícito não desfaz nada por conta própria: ele nomeia a causa e sai.
# Quem desfaz é o funil. Assim existe um caminho de rollback só, e não dois que
# podem divergir ou rodar em sequência.
abort_publication() {
    publish_abort_reason="$1"
    exit 1
}

[[ $# -ge 1 ]] || {
    usage >&2
    exit 2
}
command_name="$1"
shift

case "$command_name" in
    --help|-h)
        usage
        exit 0
        ;;
    build)
        [[ "${1-}" == "--output" && $# -eq 2 ]] || {
            usage >&2
            exit 2
        }
        output="$2"
        [[ -n "$output" ]] || fail "output vazio"
        [[ -z "$(git -C "$repo_root" status --porcelain)" ]] || fail "worktree deve estar limpo"
        commit="$(git -C "$repo_root" rev-parse HEAD)"
        [[ "$commit" =~ ^[0-9a-f]{40}$ ]] || fail "commit de origem inválido"
        version="$(sed -n 's/^version = "\([^"]*\)"$/\1/p' "$repo_root/Cargo.toml" | head -n 1)"
        [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "versão inválida"
        bundle_parent="$(dirname "$output")"
        mkdir -p "$bundle_parent"
        temporary="$bundle_parent/.pink-bundle-${commit}-$$"
        [[ ! -e "$temporary" ]] || fail "staging já existe"
        mkdir -p "$temporary"
        trap 'rm -rf "$temporary"' EXIT
        PINKER_BUILD_COMMIT="$commit" "$repo_root/ci_env.sh" cargo build --locked --release --bin pink
        target_root="${CARGO_TARGET_DIR:-$repo_root/target}"
        binary="$target_root/release/pink"
        [[ -x "$binary" ]] || fail "cargo não produziu $binary"
        install -m 0755 "$binary" "$temporary/pink"
        sha256="$(sha256sum "$temporary/pink" | awk '{print $1}')"
        [[ "$sha256" =~ ^[0-9a-f]{64}$ ]] || fail "SHA-256 inválido"
        cat >"$temporary/identity.env" <<EOF
schema=forja-pink-bundle-v1
version=$version
commit=$commit
sha256=$sha256
source=$repo_root
EOF
        identity="$($temporary/pink --version-json)"
        [[ "$identity" == *"\"binary_commit\":\"$commit\""* ]] || fail "binário não declara o commit do bundle"
        [[ ! -e "$output" ]] || fail "output já existe: $output"
        mv "$temporary" "$output"
        trap - EXIT
        printf 'bundle=%s\ncommit=%s\nsha256=%s\n' "$output" "$commit" "$sha256"
        ;;
    manifest)
        bundle=''
        release_root=''
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --bundle) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; bundle="$2"; shift 2 ;;
                --release-root) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; release_root="$2"; shift 2 ;;
                *) usage >&2; exit 2 ;;
            esac
        done
        [[ -n "$bundle" ]] || { usage >&2; exit 2; }
        read_bundle_identity "$bundle"
        [[ -n "$release_root" ]] || release_root="$forja_root/pinker/releases/pink/$commit"
        [[ "$release_root" == /* ]] || fail "release-root deve ser absoluto"
        render_manifest "$release_root" "$exposed_command"
        ;;
    ficha)
        bundle=''
        release_root=''
        perfil=''
        data=''
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --bundle) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; bundle="$2"; shift 2 ;;
                --release-root) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; release_root="$2"; shift 2 ;;
                --perfil) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; perfil="$2"; shift 2 ;;
                --data) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; data="$2"; shift 2 ;;
                *) usage >&2; exit 2 ;;
            esac
        done
        [[ -n "$bundle" ]] || { usage >&2; exit 2; }
        read_bundle_identity "$bundle"
        [[ -n "$release_root" ]] || release_root="$forja_root/pinker/releases/pink/$commit"
        [[ "$release_root" == /* ]] || fail "release-root deve ser absoluto"
        [[ -n "$perfil" ]] || perfil="$(id -un)"
        if [[ -z "$data" ]]; then
            # A data da ficha é a data do commit da release, não a de hoje: o
            # registro precisa ser reproduzível byte a byte a qualquer momento.
            [[ -e "$source/.git" ]] || fail "data não derivável: origem $source indisponível; use --data AAAA-MM-DD"
            data="$(git -C "$source" show -s --format=%cs "$commit")" ||
                fail "data não derivável do commit $commit"
        fi
        render_ficha "$release_root" "$perfil" "$data"
        ;;
    publish)
        [[ "${1-}" == "--bundle" && $# -eq 2 ]] || {
            usage >&2
            exit 2
        }
        if [[ "$forja_root" == '/opt' ]]; then
            [[ "${EUID:-$(id -u)}" -eq 0 ]] || fail "publish exige root"
            own=(-o root -g root)
        else
            own=()
        fi
        bundle="$2"
        read_bundle_identity "$bundle"
        [[ -e "$source/.git" ]] || fail "origem do bundle inválida"
        observed_sha256="$(sha256sum "$bundle/pink" | awk '{print $1}')"
        [[ "$observed_sha256" == "$expected_sha256" ]] || fail "checksum do bundle diverge"
        identity="$($bundle/pink --version-json || true)"
        [[ "$identity" == *"\"binary_commit\":\"$commit\""* ]] || fail "identidade do binário diverge do bundle"

        release_root="$forja_root/pinker/releases/pink/$commit"
        release_binary="$release_root/bin/pink"
        # O nome segue a convenção de todo software aprovado da coleção:
        # <nome>-<versão>.json. Embutir o commit aqui — como a F1 fez — converte
        # "substituir atomicamente", que é o que a política manda, em
        # "acrescentar mais uma autoridade viva".
        manifest="$forja_root/pinker/manifests/pink-${version}.json"
        install -d "${own[@]}" "$forja_root/pinker/releases/pink" "$forja_root/pinker/bin" \
            "$forja_root/pinker/manifests"

        publish_scratch="$forja_root/pinker/releases/pink/.publish-${commit}-$$"
        [[ ! -e "$publish_scratch" ]] || fail "staging já existe"
        # BEGIN. Os traps são armados antes de existir o que desfazer: armá-los
        # depois deixaria uma janela em que um sinal entre criar e armar leva o
        # staging embora sem passar pelo funil.
        publish_arm_traps
        install -d "${own[@]}" "$publish_scratch"

        # Fase 1 — captura do estado vivo anterior, antes da primeira mutação.
        # Capturar depois de mutar já seria tarde: um abort na fase da release
        # não pode remover um manifest que esta publicação nunca instalou.
        if [[ -e "$manifest" ]]; then
            publish_manifest_existed=1
            publish_manifest_backup="$publish_scratch/manifest.anterior"
            cp "$manifest" "$publish_manifest_backup"
        fi
        if [[ -L "$exposed_command" ]]; then
            publish_link_kind=symlink
            publish_link_target="$(readlink "$exposed_command")"
        elif [[ -e "$exposed_command" ]]; then
            publish_link_kind=file
            publish_link_backup="$publish_scratch/pink.anterior"
            cp "$exposed_command" "$publish_link_backup"
        else
            publish_link_kind=absent
        fi
        # PREPARE. A partir daqui existe o que desfazer, mesmo que nada exposto
        # tenha mudado: a release preparada por esta tentativa não pode ficar.
        publish_state=PREPARED

        # Fase 2 — preparo. O diretório da release entra por rename de staging e
        # nada exposto muda ainda. Se já existia, ele precisa bater com o bundle.
        if [[ -e "$release_root" ]]; then
            [[ -x "$release_binary" ]] || abort_publication "release existente está incompleta"
            existing_sha256="$(sha256sum "$release_binary" | awk '{print $1}')"
            [[ "$existing_sha256" == "$expected_sha256" ]] ||
                abort_publication "release existente possui checksum divergente"
        else
            install -d "${own[@]}" "$publish_scratch/release/bin"
            install "${own[@]}" -m 0755 "$bundle/pink" "$publish_scratch/release/bin/pink"
            mv "$publish_scratch/release" "$release_root"
            publish_release_created=1
        fi

        # Fase 3 — o candidato é julgado inteiro antes da ativação. Ele declara o
        # binário da release como comando exposto, então o validador canônico
        # exerce forma, campos, posse, cobertura de checksums e a execução real
        # do launcher sem que o comando exposto tenha sido tocado.
        candidate="$publish_scratch/candidate.json"
        final="$publish_scratch/manifest.json"
        render_manifest "$release_root" "$release_binary" >"$candidate"
        render_manifest "$release_root" "$exposed_command" >"$final"
        pre_activation_validation=UNAVAILABLE
        if command -v pinker-manifest-verify >/dev/null 2>&1; then
            pinker-manifest-verify "$candidate" >/dev/null ||
                abort_publication "candidato rejeitado por pinker-manifest-verify antes da ativação"
            pre_activation_validation=pinker-manifest-verify
        fi

        # Ainda antes de ativar: a coleção não pode acabar com duas autoridades
        # Pinker. Publicar por cima disso deixaria o validador canônico com um
        # manifest descrevendo uma instalação que não está mais exposta.
        #
        # Retirar o arquivo alheio não é decisão deste publicador: a política diz
        # que o manifest do que saiu vai para a área de evidência ou backup da
        # campanha que o removeu, e um publicador não é uma campanha. Então aqui
        # a atitude é parar e nomear, não escolher um destino por conta própria.
        superseded="$(publish_superseded_authorities "$manifest" "$forja_root/pinker/manifests")"
        if [[ -n "$superseded" ]]; then
            printf 'pink-baseline: autoridade Pinker concorrente na coleção ativa:\n%s\n' \
                "$superseded" >&2
            abort_publication "retire os manifests acima da coleção ativa antes de publicar"
        fi

        # Fase 4 — commit operacional. ACTIVATE: daqui até a conferência passar,
        # o estado vivo pode estar mudado, e qualquer término restaura.
        publish_state=ACTIVATED
        install "${own[@]}" -m 0644 "$final" "$manifest" ||
            abort_publication "instalação do manifest falhou"
        next_link="$forja_root/pinker/bin/.pink-next-$$"
        ln -s "$release_binary" "$next_link" ||
            abort_publication "não foi possível preparar o link candidato"
        # Não há transição a marcar aqui. O estado já entrou em ACTIVATED antes da
        # primeira mutação viva, que é o único ponto em que uma marca ainda chega
        # a tempo: qualquer marca DEPOIS do `mv` deixaria uma janela com o
        # launcher novo vivo e o rollback pensando que nada mudou.
        mv -Tf "$next_link" "$exposed_command" || {
            rm -f "$next_link"
            abort_publication "troca atômica do launcher falhou"
        }

        # Fase 5 — conferência pela autoridade que consome o registro, não pelo
        # emissor. Um manifest que o validador canônico rejeita não conta como
        # registro; e agora reprovar não deixa estado inválido vivo.
        verification="$("$exposed_command" --version-json || true)"
        [[ "$verification" == *"\"binary_commit\":\"$commit\""* ]] ||
            abort_publication "launcher publicado não declara $commit"
        collection_state=UNAVAILABLE
        if command -v pinker-manifest-verify >/dev/null 2>&1; then
            pinker-manifest-verify "$manifest" >/dev/null ||
                abort_publication "manifest emitido rejeitado por pinker-manifest-verify: $manifest"
            # O contrato não é "o arquivo novo é válido isolado", é "a autoridade
            # canônica aceita o estado vivo". Então a coleção inteira é
            # consultada. Uma coleção quebrada por manifest de OUTRO software não
            # é falha desta publicação — mas também não pode ser relatada como
            # saúde, então vira estado declarado.
            if pinker-manifest-verify >/dev/null 2>&1; then
                collection_state=ACCEPTED
            else
                collection_state=DEGRADED_BY_FOREIGN_MANIFEST
            fi
        fi

        # COMMIT. Só aqui o rollback é desarmado, e por estado, não por `trap -`:
        # o funil continua armado para limpar o scratch, mas deixa de ter algo a
        # desfazer. Desarmar antes desta linha deixaria uma publicação ativada e
        # não conferida sem caminho de volta; desarmar por trap deixaria o
        # scratch para trás.
        publish_state=COMMITTED
        printf 'status=PUBLISHED\nbinary=%s\nrelease=%s\nmanifest=%s\ncommit=%s\npre_activation_validation=%s\ncollection_state=%s\n' \
            "$exposed_command" "$release_root" "$manifest" "$commit" "$pre_activation_validation" \
            "$collection_state"
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

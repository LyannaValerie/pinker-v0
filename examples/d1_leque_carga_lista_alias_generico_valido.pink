pacote main;

// D1 — apelidos, especializações genéricas e recursão por lista.
//
// Um apelido **não** cria identidade nominal nova: `Numeros`, `ListaCor`,
// `ListaCor2` e as formas escritas por extenso convergem para a mesma
// identidade semântica do alvo. A monomorfização substitui em profundidade, e
// nenhuma referência residual a `T` ou `E` chega à IR validada.
leque Cor {
    Rosa,
    Azul,
}

// 7. Apelido simples de lista.
apelido Numeros = lista<bombom>;

// 8. Cadeia de apelidos, inclusive no **elemento** da lista.
apelido CorAlias = Cor;
apelido ListaCor = lista<CorAlias>;
apelido ListaCor2 = ListaCor;

leque ComAlias {
    Muitos(Numeros),
}

leque Caixa {
    Valor(ListaCor2),
}

// 9 e 10. Carga genérica monomorfizada, com listas de escalar, de texto e de
// leque.
leque Opcao<T> {
    Algum(T),
    Nenhum,
}

apelido OpcaoNumeros = Opcao<lista<bombom>>;
apelido OpcaoTextos = Opcao<lista<verso>>;
apelido OpcaoCores = Opcao<lista<Cor>>;

// Especialização de dois parâmetros, com listas de tipos diferentes em cada
// posição, e apelido encadeado da especialização.
leque Resultado2<T, E> {
    Ok(T),
    Erro(E),
}

apelido ResultadoLista = Resultado2<lista<bombom>, lista<verso>>;
apelido ResultadoListaAlias = ResultadoLista;
apelido ResultadoCores = Resultado2<lista<Cor>, verso>;

// 13. Recursão através de lista: a recursão ocorre por handle e não exige
// tamanho recursivo inline.
leque Arvore {
    Folha(bombom),
    Ramos(lista<Arvore>),
}

carinho soma_arvore(no: Arvore) -> bombom {
    nova muda total: bombom = 0;
    encaixe no {
        caso Arvore.Folha(v) {
            total = v;
        }
        caso Arvore.Ramos(ramos) {
            para cada filho em ramos {
                total = total + soma_arvore(filho);
            }
        }
    }
    mimo total;
}

carinho principal() -> bombom {
    nova ns: Numeros = lista_criar();
    lista_anexar(ns, 4);
    lista_anexar(ns, 5);
    nova a: ComAlias = ComAlias.Muitos(ns);
    encaixe a {
        caso ComAlias.Muitos(m) {
            falar(lista_tamanho(m));
            falar(lista_obter(m, 1));
        }
    }

    nova cores: ListaCor2 = lista_criar();
    lista_anexar(cores, Cor.Azul);
    lista_anexar(cores, Cor.Rosa);
    nova cx: Caixa = Caixa.Valor(cores);
    encaixe cx {
        caso Caixa.Valor(cs) {
            para cada cor em cs {
                encaixe cor {
                    caso Cor.Rosa { falar("rosa"); }
                    caso Cor.Azul { falar("azul"); }
                }
            }
        }
    }

    nova on: OpcaoNumeros = OpcaoNumeros.Algum(ns);
    encaixe on {
        caso OpcaoNumeros.Algum(x) { falar(lista_tamanho(x)); }
        caso OpcaoNumeros.Nenhum { falar(0); }
    }

    nova textos: lista<verso> = lista_criar();
    lista_anexar(textos, "eco");
    nova ot: OpcaoTextos = OpcaoTextos.Algum(textos);
    encaixe ot {
        caso OpcaoTextos.Algum(t) { falar(lista_obter(t, 0)); }
        caso OpcaoTextos.Nenhum { falar("vazio"); }
    }

    nova oc: OpcaoCores = OpcaoCores.Algum(cores);
    encaixe oc {
        caso OpcaoCores.Algum(c) { falar(lista_tamanho(c)); }
        caso OpcaoCores.Nenhum { falar(0); }
    }

    nova rl: ResultadoListaAlias = ResultadoListaAlias.Ok(ns);
    encaixe rl {
        caso ResultadoListaAlias.Ok(v) { falar(lista_tamanho(v)); }
        caso ResultadoListaAlias.Erro(e) { falar(lista_tamanho(e)); }
    }
    nova re: ResultadoLista = ResultadoLista.Erro(textos);
    encaixe re {
        caso ResultadoLista.Ok(v) { falar(lista_tamanho(v)); }
        caso ResultadoLista.Erro(e) { falar(lista_obter(e, 0)); }
    }
    nova rc: ResultadoCores = ResultadoCores.Ok(cores);
    encaixe rc {
        caso ResultadoCores.Ok(v) { falar(lista_tamanho(v)); }
        caso ResultadoCores.Erro(e) { falar(e); }
    }

    nova folhas: lista<Arvore> = lista_criar();
    lista_anexar(folhas, Arvore.Folha(6));
    lista_anexar(folhas, Arvore.Folha(7));
    nova galho: Arvore = Arvore.Ramos(folhas);

    nova raiz_filhos: lista<Arvore> = lista_criar();
    lista_anexar(raiz_filhos, galho);
    lista_anexar(raiz_filhos, Arvore.Folha(8));
    nova raiz: Arvore = Arvore.Ramos(raiz_filhos);
    falar(soma_arvore(raiz));

    mimo 0;
}

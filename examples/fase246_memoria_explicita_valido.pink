pacote main;

carinho preencher(base: seta<bombom>) -> bombom {
    *base = 41;
    nova segundo: seta<bombom> = base + 8;
    *segundo = 1;
    mimo *base + *segundo;
}

carinho principal() -> bombom {
    nova bytes: seta<u8> = alocar(16);
    nova palavras: seta<bombom> = bytes virar seta<bombom>;
    falar(preencher(palavras));
    liberar(bytes);
    mimo 0;
}

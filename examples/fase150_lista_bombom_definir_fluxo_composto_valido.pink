pacote main;

trazer lista.bombom_anexar, bombom_criar, bombom_definir, bombom_obter, bombom_tamanho;

carinho carregar_pedidos() -> lista<bombom> {
    nova pedidos: lista<bombom> = bombom_criar();
    bombom_anexar(pedidos, 40);
    bombom_anexar(pedidos, 2);
    mimo pedidos;
}

carinho aplicar_desconto(pedidos: lista<bombom>) {
    nova valor_atual: bombom = bombom_obter(pedidos, 1);
    bombom_definir(pedidos, 1, valor_atual + 8);
}

carinho principal() -> bombom {
    nova pedidos: lista<bombom> = carregar_pedidos();
    aplicar_desconto(pedidos);
    falar(bombom_tamanho(pedidos));
    falar(bombom_obter(pedidos, 1));
    mimo 0;
}

pacote main;

trazer mapa.bombom_bombom_criar, bombom_bombom_definir, bombom_bombom_obter, bombom_verso_criar, bombom_verso_definir, bombom_verso_obter, verso_bombom_criar, verso_bombom_definir, verso_bombom_obter, verso_bombom_remover, verso_bombom_tamanho, verso_bombom_tem, verso_verso_criar, verso_verso_definir, verso_verso_obter;

carinho principal() -> bombom {
    nova notas: mapa<verso,bombom> = verso_bombom_criar();
    verso_bombom_definir(notas, "rosa", 10);
    verso_bombom_definir(notas, "pinker", 9);
    verso_bombom_definir(notas, "rosa", 8);
    falar("tamanho:", verso_bombom_tamanho(notas));
    falar("rosa:", verso_bombom_obter(notas, "rosa"));
    talvez verso_bombom_tem(notas, "pinker") {
        falar("tem pinker");
    }
    verso_bombom_remover(notas, "pinker");
    falar("apos remover:", verso_bombom_tamanho(notas));

    nova nomes: mapa<bombom,verso> = bombom_verso_criar();
    bombom_verso_definir(nomes, 1, "um");
    para cada chave em nomes {
        falar(chave, bombom_verso_obter(nomes, chave));
    }

    nova pares: mapa<bombom,bombom> = bombom_bombom_criar();
    bombom_bombom_definir(pares, 21, 42);
    nova traducoes: mapa<verso,verso> = verso_verso_criar();
    verso_verso_definir(traducoes, "flor", "rosa");
    falar(verso_verso_obter(traducoes, "flor"));
    mimo bombom_bombom_obter(pares, 21) - 42;
}

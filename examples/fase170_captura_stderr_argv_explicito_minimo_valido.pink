pacote main;

trazer ambiente.argumento;
trazer processo.capturar_stderr;
trazer texto.contem, tamanho;

carinho principal() -> bombom {
    nova comando: verso = argumento(0);
    nova texto: verso = capturar_stderr(comando, "--alvo=rosa");
    nova tem_erro: logica = contem(texto, "erro=sim");
    nova tem_alvo: logica = contem(texto, "alvo=rosa");
    falar(texto);
    talvez tem_erro && tem_alvo && tamanho(texto) == 19 {
        mimo 0;
    }
    mimo 1;
}

pacote main;

trazer memoria.alocar;
trazer memoria.liberar;

carinho principal() -> bombom {
    nova bytes: seta<u8> = alocar(67108864);
    nova meio: seta<u8> = bytes + 33554432;
    nova fim: seta<u8> = bytes + 67108863;
    falar(*bytes);
    falar(*meio);
    falar(*fim);
    *bytes = 7;
    *meio = 8;
    *fim = 9;
    falar(*bytes + *meio + *fim);
    liberar(bytes);
    mimo 0;
}

pacote main;

trazer ambiente.argumento;
trazer processo.capturar_stderr;
trazer texto.contem;
trazer texto.tamanho;

carinho principal() -> bombom {
    nova comando: verso = argumento(0);
    nova texto: verso = capturar_stderr(comando);
    nova tem_erro: logica = contem(texto, "erro=sim");
    nova tem_codigo: logica = contem(texto, "codigo=9");
    falar(texto);
    talvez tem_erro && tem_codigo && tamanho(texto) == 18 {
        mimo 0;
    }
    mimo 1;
}

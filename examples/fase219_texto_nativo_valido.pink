pacote main;

trazer texto.aparar;
trazer texto.bombom_para_verso;
trazer texto.buscar;
trazer texto.comeca_com;
trazer texto.contem;
trazer texto.dividir_contar;
trazer texto.dividir_em;
trazer texto.formatar;
trazer texto.indice;
trazer texto.indice_em;
trazer texto.juntar;
trazer texto.juntar_com;
trazer texto.maiusculo;
trazer texto.minusculo;
trazer texto.nao_vazio;
trazer texto.substituir;
trazer texto.termina_com;
trazer texto.vazio;
trazer texto.verso_para_bombom;

carinho principal() -> bombom {
    nova fonte: verso = "  Rosa Pinker canta 42 versos  ";
    nova limpo: verso = aparar(fonte);
    falar(limpo);
    falar(minusculo(limpo));
    falar(maiusculo("pinker"));

    talvez contem(limpo, "canta") {
        falar("contem canta");
    }
    talvez comeca_com(limpo, "Rosa") {
        falar("comeca com Rosa");
    }
    talvez termina_com(limpo, "versos") {
        falar("termina com versos");
    }

    falar("indice de canta:", indice_em(limpo, "canta"));
    falar("buscar Pinker:", buscar(limpo, "Pinker"));
    falar("primeira letra:", indice(limpo, 0));

    falar("pedacos:", dividir_contar(limpo, " "));
    falar("quarto pedaco:", dividir_em(limpo, " ", 3));

    falar(substituir(limpo, "canta", "escreve"));
    falar(juntar_com("rosa", " & ", "pinker"));

    nova numero: bombom = verso_para_bombom(dividir_em(limpo, " ", 3));
    falar("numero + 1:", numero + 1);
    falar(juntar("como verso: ", bombom_para_verso(numero)));

    talvez nao_vazio(limpo) {
        falar(formatar("modelo: {} tem {} pedacos", limpo, dividir_contar(limpo, " ")));
    }
    talvez vazio("") {
        falar("vazio confere");
    }
    mimo numero - 42;
}

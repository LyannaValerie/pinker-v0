pacote main;

trazer ambiente.argumento_ou;
trazer arquivo.criar, escrever_verso, fechar, ler_caminho_ou, ler_caminho_verso;
trazer texto.igual;

carinho principal() -> bombom {
    nova alvo: verso = argumento_ou(0, "/tmp/pinker_fase109_exemplo.txt");
    nova h: bombom = criar(alvo);
    escrever_verso(h, "fase109");
    fechar(h);

    nova lido: verso = ler_caminho_verso(alvo);
    nova fallback: verso = ler_caminho_ou("__pinker_fase109_inexistente__.txt", "padrao109");
    falar(lido);
    falar(fallback);

    talvez igual(lido, "fase109") {
        talvez igual(fallback, "padrao109") {
            mimo 1;
        } senao {
            mimo 0;
        }
    } senao {
        mimo 0;
    }
}

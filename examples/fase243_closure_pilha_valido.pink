pacote main;

carinho fabricar_soma7(inc: bombom) -> carinho(bombom, bombom, bombom, bombom, bombom, bombom, bombom) -> bombom {
    mimo carinho(a: bombom, b: bombom, c: bombom, d: bombom, e: bombom, f: bombom, g: bombom) -> bombom {
        mimo a + b + c + d + e + f + g + inc;
    };
}

carinho aplicar7(
    operacao: carinho(bombom, bombom, bombom, bombom, bombom, bombom, bombom) -> bombom,
    a: bombom, b: bombom, c: bombom, d: bombom, e: bombom, f: bombom, g: bombom
) -> bombom {
    mimo operacao(a, b, c, d, e, f, g);
}

carinho principal() -> bombom {
    nova somar: carinho(bombom, bombom, bombom, bombom, bombom, bombom, bombom) -> bombom = fabricar_soma7(100);
    nova resultado: bombom = aplicar7(somar, 1, 2, 3, 4, 5, 6, 7);
    falar(resultado);
    mimo 0;
}

pacote main;

trazer ambiente.argumento_ou;
trazer caminho.e_arquivo, existe;
trazer processo.sair;

carinho principal() -> bombom {
    nova alvo: verso = argumento_ou(0, "README.md");
    falar(existe(alvo));
    falar(e_arquivo(alvo));
    talvez existe(alvo) {
        talvez e_arquivo(alvo) {
            mimo 1;
        } senao {
            falar("nao_arquivo");
            sair(2);
            mimo 0;
        }
    } senao {
        falar("ausente");
        sair(3);
        mimo 0;
    }
}

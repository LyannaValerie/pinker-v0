pacote main;

trazer lista.anexar;
trazer lista.criar;
trazer lista.tamanho;
trazer lista.tirar_ultimo;

leque Cor { Vermelho, Verde, Azul }

carinho principal() -> bombom {
    nova cores: lista<Cor> = criar();
    anexar(cores, Cor.Vermelho);
    anexar(cores, Cor.Azul);
    anexar(cores, Cor.Verde);
    falar(tamanho(cores));

    para cada cor em cores {
        escolha cor {
            caso Cor.Vermelho { falar("quente"); }
            senao { falar("fria"); }
        }
    }

    nova ultima: Cor = tirar_ultimo(cores);
    talvez ultima == Cor.Verde {
        falar("verde saiu");
    }
    mimo 0;
}

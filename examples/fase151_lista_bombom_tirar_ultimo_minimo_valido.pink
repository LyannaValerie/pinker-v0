pacote main;

trazer lista.bombom_anexar;
trazer lista.bombom_criar;
trazer lista.bombom_obter;
trazer lista.bombom_tamanho;
trazer lista.bombom_tirar_ultimo;

carinho principal() -> bombom {
    nova lista: lista<bombom> = bombom_criar();
    bombom_anexar(lista, 7);
    bombom_anexar(lista, 11);
    nova removido: bombom = bombom_tirar_ultimo(lista);
    falar(removido);
    falar(bombom_tamanho(lista));
    mimo bombom_obter(lista, 0);
}

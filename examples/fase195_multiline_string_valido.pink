pacote main;

trazer assertiva.afirmar;
trazer texto.contem;
trazer texto.vazio;

carinho principal() -> bombom {
    nova texto: verso = """primeira linha
segunda linha
terceira linha""";

    afirmar(contem(texto, "primeira"), "deveria conter 'primeira'");
    afirmar(contem(texto, "segunda"), "deveria conter 'segunda'");
    afirmar(contem(texto, "terceira"), "deveria conter 'terceira'");

    nova cadeia_vazia: verso = """""";
    afirmar(vazio(cadeia_vazia), "triple-quoted vazia deveria ser vazia");

    falar("multi-line strings ok");
    mimo 0;
}

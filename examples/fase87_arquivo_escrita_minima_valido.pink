pacote fase87_arquivo_escrita_minima_valido;

trazer arquivo.abrir, escrever_bombom, fechar, ler_bombom;

carinho principal() -> bombom {
    nova handle: bombom = abrir("examples/fase87_output_numero.txt");
    escrever_bombom(handle, 42);
    nova valor: bombom = ler_bombom(handle);
    fechar(handle);
    falar(valor);
    mimo 0;
}

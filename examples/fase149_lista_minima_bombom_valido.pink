pacote fase149_lista_minima_bombom_valido;

trazer lista.bombom_anexar, bombom_criar, bombom_obter;

carinho principal() -> bombom {
    nova lista: lista<bombom> = bombom_criar();
    bombom_anexar(lista, 5);
    bombom_anexar(lista, 8);
    falar(bombom_obter(lista, 0));
    falar(bombom_obter(lista, 1));
    mimo 0;
}

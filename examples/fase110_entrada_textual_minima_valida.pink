pacote main;

trazer entrada.ouvir_verso, ouvir_verso_ou;
trazer texto.aparar, nao_vazio;

carinho principal() -> bombom {
    nova texto: verso = ouvir_verso();
    falar(texto);
    falar(nao_vazio(aparar(texto)));

    nova fallback: verso = ouvir_verso_ou("padrão-fase110");
    falar(fallback);

    mimo 0;
}
